          <Pad Id="SriEWfYAFqdcEoDAz4syth" Comment="Frame Latency (ms)" Bounds="372,665,60,15" ShowValueBox="true" isIOBox="true" />
          <Pad Id="Kpt8nXxdVo6lLWb51ukZMA" Bounds="450,585,420,100" ShowValueBox="true" isIOBox="true" Value="Every texture frame gets an id. The page echoes it back with its results, so Frame Id says which frame the current results belong to, and Frame Latency (ms) is the time from sending that frame to receiving its results, measured on vvvv's clock (it includes Detection Time). A new frame is only sent once the page has answered the previous one; frames in between are skipped, so latency does not pile up.">
            <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
              <Choice Kind="TypeFlag" Name="String" />
            </p:TypeAnnotation>
