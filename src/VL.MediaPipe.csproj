<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <!-- Build into bin\ and copy to lib\ (below): vvvv loads lib\net8.0\VL.MediaPipe.dll, and a vvvvc export rebuilds
         this project while holding that file open, which fails when lib\ is the build output. -->
    <OutputPath>..\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <Target Name="CopyToLib" AfterTargets="Build">
    <ItemGroup>
      <_LibFile Include="$(OutDir)$(AssemblyName).dll;$(OutDir)$(AssemblyName).pdb;$(OutDir)$(AssemblyName).xml;$(OutDir)$(AssemblyName).deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_LibFile)" DestinationFolder="..\lib\$(TargetFramework)\" SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" Condition="Exists('%(FullPath)')" />
  </Target>

  <ItemGroup>
    <PackageReference Include="VL.Core" Version="2024.6.6" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="VL.Core" />
    <Using Include="VL.Core.Import" />
    <Using Include="VL.Lib.Collections" />
    <Using Include="Stride.Core.Mathematics" />
  </ItemGroup>

</Project>
