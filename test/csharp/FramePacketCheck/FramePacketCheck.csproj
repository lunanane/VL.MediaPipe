<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console checks of src\FramePacket.cs and src\FrameMetadata.cs against lib\net8.0\VL.MediaPipe.dll (not rebuilt here).
       Run through scripts\test-texture-input.ps1; writes packets that test\framepacket\check_packets.mjs parses with the page's parser. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Outside the repo on purpose: this output holds a copy of VL.MediaPipe.dll, and a vvvvc export of VL.MediaPipe.vl
         finds any VL.MediaPipe.dll under the package folder (NETSDK1152, duplicate publish output). -->
    <OutputPath>$([System.IO.Path]::GetTempPath())VL.MediaPipe.FramePacketCheck\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VL.Core" Version="2024.6.6" />
    <Reference Include="VL.MediaPipe">
      <HintPath>..\..\..\lib\net8.0\VL.MediaPipe.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
